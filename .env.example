# ==============================================================================
# Subscription Management System - Environment Configuration
# ==============================================================================

# Application Runtime Environment (development | test | production)
NODE_ENV=development

# API Server Configuration
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Web Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Subscription Management System"

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_db?schema=public"

# Redis Connection (BullMQ and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Authentication Security (JWT)
AUTH_SECRET="your-super-secret-jwt-key-min-32-characters-change-in-production"
AUTH_ACCESS_TOKEN_EXPIRY="15m"
AUTH_REFRESH_TOKEN_EXPIRY="7d"

# Background Worker Settings
WORKER_CONCURRENCY=5

# SMTP Email Configuration (Phase 5+)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your-smtp-user"
EMAIL_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@subscriptionmanager.com"

# S3-Compatible Object Storage (Phase 5+)
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="invoices"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"

# Optional Payment Gateway Integration (Phase 6/8 Extension)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
